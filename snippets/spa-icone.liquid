{% comment %}
  Pictogrammes trait fin de la section « Critères ».

  Dessinés ici plutôt que téléversés en images : ils héritent ainsi de la
  couleur du texte (currentColor), restent nets sur tous les écrans et ne
  coûtent aucune requête réseau.

  Accepte :
  - nom : {String} identifiant du picto (voir le case ci-dessous)
{% endcomment %}

{%- capture svg_ouvrant -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- endcapture -%}

{{ svg_ouvrant }}
{%- case nom -%}
  {%- when 'utilisateurs' -%}
    <circle cx="9" cy="8" r="3.2"/>
    <path d="M2.8 20c0-3.4 2.8-5.4 6.2-5.4s6.2 2 6.2 5.4"/>
    <path d="M16.6 6.4a2.9 2.9 0 0 1 0 5.6"/>
    <path d="M18.2 14.8c1.9.7 3 2.3 3 4.6"/>
  {%- when 'assises' -%}
    <path d="M6 12V8.2A2.2 2.2 0 0 1 8.2 6h7.6A2.2 2.2 0 0 1 18 8.2V12"/>
    <path d="M4 12a2 2 0 1 1 2 2.2V17.5h12V14.2A2 2 0 1 1 20 12"/>
    <path d="M6.8 17.5v2.2M17.2 17.5v2.2"/>
  {%- when 'maison' -%}
    <path d="M3 10.6 12 3.2l9 7.4"/>
    <path d="M5.2 9.4V20.4h13.6V9.4"/>
    <path d="M9.8 20.4v-5.8h4.4v5.8"/>
  {%- when 'acces' -%}
    <path d="M17.4 2.6a3.6 3.6 0 0 1 3.6 3.6c0 2.7-3.6 6.2-3.6 6.2s-3.6-3.5-3.6-6.2a3.6 3.6 0 0 1 3.6-3.6z"/>
    <circle cx="17.4" cy="6.2" r="1.2"/>
    <path d="M14.2 11.8c-2.9 1.7-5.3 2.2-7.2 4.2-1.6 1.7-1.9 3.3-2 4.6" stroke-dasharray="2 2.6"/>
  {%- when 'electricite' -%}
    <path d="M9 3.2v4.6M15 3.2v4.6"/>
    <path d="M6 7.8h12v2.4a6 6 0 0 1-12 0V7.8z"/>
    <path d="M12 16.2v4.6"/>
  {%- when 'livraison' -%}
    <path d="M2.4 5.6h10.8v10.2H2.4z"/>
    <path d="M13.2 8.8h3.9l4.5 3.6v3.4h-8.4"/>
    <circle cx="6.6" cy="18.2" r="2.2"/>
    <circle cx="17.4" cy="18.2" r="2.2"/>
    <path d="M8.8 18.2h6.4"/>
  {%- when 'conseil' -%}
    <path d="M3.4 5.4h17.2v10.2H11.4l-5 3.9v-3.9H3.4z"/>
    <path d="M8.2 10.4h7.6"/>
  {%- when 'expertise' -%}
    <circle cx="12" cy="12" r="3.2"/>
    <path d="M12 2.6v2.4M12 19v2.4M4.6 7.2l2.1 1.2M17.3 15.6l2.1 1.2M4.6 16.8l2.1-1.2M17.3 8.4l2.1-1.2"/>
  {%- when 'showroom' -%}
