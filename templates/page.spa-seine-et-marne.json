        "surtitre": "Nos installations",
        "titre": "Ce que nous avons installé en Seine‑et‑Marne",
        "chapeau": "<p>Un chantier récent dans le département, et il porte sur ce qui se décide avant la livraison plutôt que pendant.</p>",
        "ancre": "realisations-77",
        "filet": true,
        "color_scheme": "scheme-1",
