        "titre": "Les spas exposés ne sont pas remplis",
        "texte": "<p>Vous pouvez y entrer et vous y installer, mais il n'y a pas d'essai en eau. Nous préférons vous le dire ici plutôt que sur le pas de la porte.</p>",
        "html": "",
        "largeur": "lecture",
        "encadre": true,
        "ancre": "",
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 40
