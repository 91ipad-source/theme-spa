    "ch1": {
      "type": "spa-chapitre",
      "settings": {
        "numero": "01",
        "surtitre": "Votre accès",
        "titre": "Des accès praticables, et un détail qui coince",
        "chapeau": "<p>Cergy, Pontoise, Argenteuil, Enghien‑les‑Bains&nbsp;: pavillons, accès généralement praticables, terrains de plain‑pied.</p>",
        "ancre": "acces-95",
        "filet": true,
