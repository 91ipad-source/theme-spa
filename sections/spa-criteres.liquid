{% comment %}
  Critères de choix, appel à l'action et bande de réassurance.

  Reprend en HTML le visuel « À propos de SPAS9 » : mêmes pictos, mêmes
  libellés, même encadré. La différence tient à ce que le texte est du vrai
  texte — lisible sur un écran de téléphone, lu par Google et par les
  lecteurs d'écran — et que le bouton est un vrai lien.

  Les pictos sont dessinés dans snippets/spa-icone.liquid.
{% endcomment %}

{%- liquid
  assign criteres = section.blocks | where: 'type', 'critere'
  assign reassurances = section.blocks | where: 'type', 'reassurance'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="spa-criteres color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="spa-criteres__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if criteres.size > 0 -%}
      <ul class="spa-picto-grid" role="list">
        {%- for block in criteres -%}
          <li class="spa-picto" {{ block.shopify_attributes }}>
            <span class="spa-picto__icone">
              {%- if block.settings.icone_image != blank -%}
                {{ block.settings.icone_image | image_url: width: 192 | image_tag: loading: 'lazy', widths: '64, 128, 192', sizes: '64px', alt: '' }}
              {%- endif -%}
            </span>
            <span class="spa-picto__label">{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank or section.settings.cta_text != blank -%}
      <div class="spa-criteres__cta">
        <span class="spa-criteres__cta-icone">{% render 'spa-icone', nom: 'bulle' %}</span>

        <div class="spa-criteres__cta-texte">
          {%- if section.settings.cta_heading != blank -%}
            <p class="spa-criteres__cta-titre">{{ section.settings.cta_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.cta_text != blank -%}
            <p class="spa-criteres__cta-sous-titre">{{ section.settings.cta_text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank -%}
          <a class="spa-criteres__bouton button" href="{{ section.settings.cta_button_link }}">
            {{- section.settings.cta_button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if reassurances.size > 0 -%}
      <ul class="spa-criteres__reassurance list-unstyled" role="list">
        {%- for block in reassurances -%}
          <li class="spa-criteres__gage" {{ block.shopify_attributes }}>
            <span class="spa-criteres__icone spa-criteres__icone--petit">
              {%- if block.settings.icone_image != blank -%}
                {{ block.settings.icone_image | image_url: width: 132 | image_tag: loading: 'lazy', widths: '44, 88, 132', sizes: '44px', alt: '' }}
              {%- endif -%}
            </span>
            <span class="spa-criteres__gage-label">{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Critères et réassurance",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la rangée de critères",
      "default": "Plusieurs éléments essentiels pour un choix adapté"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Jeu de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Encadré d'appel à l'action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Titre",
      "default": "Vous avez un projet ?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte",
      "default": "Parlez-nous de vos besoins et nous vous aiderons à comparer les modèles adaptés."
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "Libellé du bouton",
      "default": "Nous contacter"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge haute",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge basse",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "critere",
      "name": "Critère",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icone_image",
          "label": "Pictogramme",
          "info": "PNG à fond transparent ou SVG."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Le nombre d'utilisateurs"
        }
      ]
    },
    {
      "type": "reassurance",
      "name": "Gage de confiance",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icone_image",
          "label": "Pictogramme",
          "info": "PNG à fond transparent ou SVG."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Conseil personnalisé"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Critères et réassurance"
    }
  ]
}
{% endschema %}
